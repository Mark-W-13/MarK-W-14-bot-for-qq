.mcp.json
.claude/

# 服务器凭据 / 登录信息(明文密码,绝不入库)
服务器凭据(勿外传).txt
远程服务器信息.txt

# 运行时数据(群消息记录 / 日志 / 抽卡状态 / 功能开关 / 框神语录库 / AI 闲聊记账)
agent/inbox.jsonl
agent/processed.jsonl
agent/daily_card.json
agent/features.json
agent/aichat_stats.json
# AI 闲聊提示词档位(运维台可随时切,属运行时状态而非配置;首启以 AI_CHAT_TONE 为初值)
agent/aichat/tone.json
# 联网搜索次数记账
agent/search_stats.json
agent/*.log
agent/kuangshen/quotes.json
agent/kuangshen/blacklist.json
agent/kuangshen/pending.json

# SnowLuma 第三方运行时 + QQ 数据 + 日志(重装/保留本地即可)
tools/

