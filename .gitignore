# 敏感配置(含 QQ token,不入库)
.env
.mcp.json
.claude/

# 服务器凭据 / 登录信息(明文密码,绝不入库)
服务器凭据(勿外传).txt
远程服务器信息.txt

# 运行时数据(群消息记录 / 日志 / 抽卡状态 / 功能开关 / 框神语录库 / AI 闲聊记账)
agent/inbox.jsonl
agent/processed.jsonl
agent/daily_card.json
agent/features.json
agent/aichat_stats.json
# AI 闲聊提示词档位(运维台可随时切,属运行时状态而非配置;首启以 AI_CHAT_TONE 为初值)
agent/aichat/tone.json
# 联网搜索次数记账
agent/search_stats.json
agent/*.log
# SYSTEM 控制台审计日志(谁在哪个群发了什么命令,运行时数据)
agent/admin_audit.jsonl
agent/kuangshen/quotes.json
agent/kuangshen/blacklist.json
agent/kuangshen/pending.json

# SnowLuma 第三方运行时 + QQ 数据 + 日志(重装/保留本地即可)
tools/

# 卡牌卡库(体积大,可随时联网更新)
agent/ygocard/cards.json
agent/ygocard/cards.zip
agent/ygocard/faq_cache.json
downloads/

# 临时文件
*.tmp
tmp_*
agent/ygocard/tmp/

# 卡图数据库(体积大,可重下重建)
agent/ygocard/cards_img/

# 炉石:卡库(9.6MB,可 --update-cards 重下)/ 卡图缓存(按需下)/ 环境数据缓存与每日一卡状态
agent/hs/data/
agent/hs/cards_img/
agent/hs_daily_card.json
agent/modes.json

# 贴吧模式的分群开关(运行时状态:运维台/群里随时切,首启以 TIEBA_ENABLED 为初值)
agent/tieba/state.json

# 银河皇帝模式的分群开关 / 运维台上传的表情包 / 语音缓存(种子表情包入库,上传与缓存不入库)
agent/belial/state.json
agent/belial/voice_state.json
agent/belial/sticker_meta.json
agent/belial/stickers/up_*
agent/belial/voice_cache/

# 脚刷周模式(2026-10-29):表情包库的运行时元数据/上传图;种子图入库,开关与贝利亚共用 state.json
agent/jiaoshuazhou/sticker_meta.json
agent/jiaoshuazhou/stickers/up_*

# 人格记忆库(2026-10-29):群里模型自己增删的长期记忆/风格调整,运行时数据不入库
agent/persona/memory.json

# 游戏王环境饼图(2026-10-26):贴吧抓取缓存 / 统计结果 / 生成的 PNG / 代表卡索引
# 全部可重建;缓存目录里的 pages/threads 会随使用变大,不入库
agent/ygometa/cache/

# 用户投喂的屎素材 + 搬屎运行时数据(渲染临时文件 / 待反馈 / 源库 LRU 记忆)
屎/
agent/shitpost/tmp/
agent/shitpost/pending.json
agent/shitpost/seed_memory.json

# 服务器部署位的屎库/样本(随数据迁移,不入库)
data/
